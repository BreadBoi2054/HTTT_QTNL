# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

# Documents, PDFs, Word reports & Batch scripts (non-code files)
*.pdf
*.docx
*.doc
*.xlsx
*.pptx
*.bat
~$*

# AI Agent, UI audit screenshots & scratch workspace files
/.agents/
/.taste-skill/
/scratch/
/DESIGN.md
/CLAUDE.md
/AUDIT_*.md
/ui-polish-redesign.md
/log.md

# Python report generators & cache
__pycache__/
*.py[cod]
/scripts/*_diagrams/
/scripts/report_generator/
/scripts/*.py
